# Satemshi App — environment variables
# Copy this file to .env and fill in your own values. .env is gitignored.

# Path to your Obsidian vault on this machine (absolute path).
# The app will write Daily Notes/ entries here, and the ingest
# pipeline will read from here and update Wiki/.
VAULT_PATH=/path/to/your/vault

# Bind address for the FastAPI server.
# Use a Tailscale IP (100.x.y.z) to keep the app off the public internet.
# Use 127.0.0.1 for local-only development.
APP_BIND_HOST=127.0.0.1
APP_BIND_PORT=8765

# Path to instance config (overrides config.example.yaml).
# Leave unset to use ./config.yaml in the repo working directory.
SATEMSHI_CONFIG=

# LINE Bot credentials, from the LINE Developers console for your
# Messaging API channel (https://developers.line.biz/console/).
# Channel secret — used to verify the X-Line-Signature on every webhook
# call. Without it, the webhook rejects everything.
LINE_CHANNEL_SECRET=
# Long-lived channel access token — used to reply and to download the
# photos sent to the bot.
LINE_CHANNEL_ACCESS_TOKEN=

# Anthropic API key (only needed if any task uses the Claude provider).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Ollama base URL (only needed if any task uses the Ollama provider).
# Default for a local Ollama install:
OLLAMA_BASE_URL=http://localhost:11434
